# =============================================================================
# Large data files (review case-by-case before un-ignoring)
# =============================================================================
*.parquet
*.h5
*.hdf5
*.npy
*.npz
# *.csv          # uncomment if you don't want to commit any CSVs
# *.json         # uncomment if you don't want to commit any JSONs

# Allow release-shipped sample artifacts (gated by paper §A.6):
!annotations/pkpd.parquet
!annotations/*_sample.parquet
!splits/seed*/*.pkl
!splits/seed*_800/*.pkl
!annotation/*_metrics.json
!annotation/release/final_consensus.csv
# Toy splits ship in data/public/ — sample-only release-friendly:
!data/public/intermediate/splits/**/*.parquet
!data/public/intermediate/splits/**/*.json

