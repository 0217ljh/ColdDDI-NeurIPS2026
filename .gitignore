# Allow the public toy XML (small subset shipped for pipeline smoke tests):
!data/public/drugbank_toy.xml

# =============================================================================
# data/private/ — DrugBank-licensed artifacts; only structure is tracked
# =============================================================================
data/private/**
!data/private/
!data/private/**/
!data/private/**/.gitkeep
!data/private/_README.md

